# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI GPT-4o / GPT-4o-mini decision reasoning.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ANTHROPIC_API_KEY: Required for Claude 3.5 Sonnet / Haiku decision reasoning.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# XAI_API_KEY: Required for Grok-2 / Grok-beta decision reasoning.
XAI_API_KEY="MY_XAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
